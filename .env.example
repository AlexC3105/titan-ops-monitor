# CARTO basemap key (browser-visible; restrict it to your sites in CARTO).
# CARTO needs a separate key for localhost. Put real values in .env.local (git-ignored).
VITE_CARTO_BASEMAP_KEY=

# Optional: point the app at a local API Worker instead of the deployed one.
# VITE_TITAN_API_BASE=http://localhost:8787
